    "lines": [
     {
      "lead": 0,
      "text": "# Smart Thermostat · Main PCBA bench tests (made-up demo)"
     },
     {
      "lead": 0,
      "text": "# One step per line; indent to nest. The rows and this text are the same thing."
     },
     {
      "lead": 0,
      "text": ""
     },
     {
      "lead": 0,
      "text": "suite Main PCBA"
     },
     {
      "lead": 2,
      "text": "group Power"
     },
     {
      "lead": 4,
      "text": "test PWR-01 Powers up at 24 V [REQ-004]"
     },
     {
      "lead": 6,
      "text": "PSU.set_current_limit 500 mA"
     },
     {
      "lead": 6,
      "text": "PSU.set_voltage 24 V"
     },
     {
      "lead": 6,
      "text": "PSU.output on"
     },
     {
      "lead": 6,
      "text": "wait until MAIN.state == \"RUN\" within 5 s"
     },
     {
      "lead": 6,
      "text": "check PSU.current 40 mA .. 90 mA"
     },
     {
      "lead": 6,
      "text": "check MAIN.rail_3v3 3.3 V ±3%"
     },
     {
      "lead": 6,
      "text": "cleanup"
     },
     {
      "lead": 8,
      "text": "PSU.output off"
     },
     {
      "lead": 4,
      "text": "test PWR-02 3V3 ripple with both relays on [REQ-005]"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "MAIN.relay 1 on"
     },
     {
      "lead": 6,
      "text": "MAIN.relay 2 on"
     },
     {
      "lead": 6,
      "text": "wait 200 ms"
     },
     {
      "lead": 6,
      "text": "SCOPE.measure 1 vpp -> ripple"
     },
     {
      "lead": 6,
      "text": "check ripple < 50 mV"
     },
     {
      "lead": 6,
      "text": "cleanup"
     },
     {
      "lead": 8,
      "text": "MAIN.relay 1 off"
     },
     {
      "lead": 8,
      "text": "MAIN.relay 2 off"
     },
     {
      "lead": 4,
      "text": "test PWR-03 Brown-out threshold [REQ-006]"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "script"
     },
     {
      "lead": 8,
      "text": "# Step the supply down until the board stops answering RUN."
     },
     {
      "lead": 8,
      "text": "v = 24.0"
     },
     {
      "lead": 8,
      "text": "while v > 6:"
     },
     {
      "lead": 12,
      "text": "v -= 0.5"
     },
     {
      "lead": 12,
      "text": "cmd('PSU.set_voltage', f'{v} V')"
     },
     {
      "lead": 12,
      "text": "wait(150)"
     },
     {
      "lead": 12,
      "text": "try:"
     },
     {
      "lead": 16,
      "text": "state = tlm('MAIN.state')"
     },
     {
      "lead": 12,
      "text": "except Exception:"
     },
     {
      "lead": 16,
      "text": "state = 'OFF'"
     },
     {
      "lead": 12,
      "text": "if state != 'RUN':"
     },
     {
      "lead": 16,
      "text": "break"
     },
     {
      "lead": 8,
      "text": "record('brownout', v, 'V')"
     },
     {
      "lead": 8,
      "text": "log(f'Board dropped out at {v} V')"
     },
     {
      "lead": 6,
      "text": "check brownout < 9 V"
     },
     {
      "lead": 6,
      "text": "cleanup"
     },
     {
      "lead": 8,
      "text": "PSU.set_voltage 24 V"
     },
     {
      "lead": 2,
      "text": "group Firmware"
     },
     {
      "lead": 4,
      "text": "test FW-01 Boot banner on the debug UART [REQ-011]"
     },
     {
      "lead": 6,
      "text": "LOGIC.arm uart 115200"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "LOGIC.read -> banner"
     },
     {
      "lead": 6,
      "text": "check banner contains \"self-test OK\""
     },
     {
      "lead": 6,
      "text": "check MAIN.fw_version == \"1.4.2\""
     },
     {
      "lead": 4,
      "text": "test FW-02 Relays follow commands [REQ-012]"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "for n in 1, 2"
     },
     {
      "lead": 8,
      "text": "MAIN.relay $n on"
     },
     {
      "lead": 8,
      "text": "wait 50 ms"
     },
     {
      "lead": 8,
      "text": "check MAIN.relay$n == \"closed\""
     },
     {
      "lead": 8,
      "text": "MAIN.relay $n off"
     },
     {
      "lead": 8,
      "text": "wait 50 ms"
     },
     {
      "lead": 8,
      "text": "check MAIN.relay$n == \"open\""
     },
     {
      "lead": 4,
      "text": "test FW-03 Backlight PWM frequency"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "SCOPE.measure 2 freq -> pwm"
     },
     {
      "lead": 6,
      "text": "check pwm 20 kHz ±5%"
     },
     {
      "lead": 2,
      "text": "group Operator"
     },
     {
      "lead": 4,
      "text": "test UI-01 Display shows the set point [REQ-020]"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "MAIN.set_point 21.5 °C"
     },
     {
      "lead": 6,
      "text": "ask \"Does the display read 21.5 °C?\""
     },
     {
      "lead": 4,
      "text": "test UI-02 Board temperature after warm-up"
     },
     {
      "lead": 6,
      "text": "call PWR-01"
     },
     {
      "lead": 6,
      "text": "wait 2 s"
     },
     {
      "lead": 6,
      "text": "measure MAIN.temp as board_temp"
     },
     {
      "lead": 6,
      "text": "check board_temp < 45 °C"
     }
    ],
